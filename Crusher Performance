        <div class="stat-mini">
          <div class="stat-mini-label">Target</div>
          <div class="stat-mini-value">${c.target}</div>
        </div>
        <div class="stat-mini">
          <div class="stat-mini-label">Active Days</div>
          <div class="stat-mini-value">${c.days}</div>
        </div>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar" style="width:${barWidth}%;background:${barColor}"></div>
      </div>
      <div class="progress-label">
        <span>Utilization</span>
        <span><strong>${fmt1(util)}%</strong> of target</span>
      </div>
    </div>`;
});

// Table
const tbody = document.querySelector('#crusherTable tbody');
Object.entries(DATA.crushers).forEach(([name, c]) => {
  const util = c.utilization;
  let s = '<span class="status-pill status-good">EXCELLENT</span>';
  if (util < 70) s = '<span class="status-pill status-poor">BELOW TARGET</span>';
  else if (util < 90) s = '<span class="status-pill status-warn">ACCEPTABLE</span>';
  tbody.innerHTML += `
    <tr>
      <td><strong>Crusher ${name.replace('CR','')}</strong></td>
      <td>${fmt1(c.avg)}</td>
      <td>${fmt1(c.max)}</td>
      <td>${c.target}</td>
      <td>${fmt1(util)}%</td>
      <td>${c.days}</td>
      <td>${s}</td>
    </tr>`;
});

// Chart styling
Chart.defaults.color = '#cbd5e1';
Chart.defaults.borderColor = '#334155';
Chart.defaults.font.family = "'Segoe UI', Arial, sans-serif";
const gridColor = 'rgba(71, 85, 105, 0.3)';

// Throughput chart
new Chart(document.getElementById('throughputChart'), {
  type: 'bar',
  data: {
    labels: DATA.monthly.months,
    datasets: [
      {label: 'Coal In', data: DATA.monthly.coal_in, backgroundColor: '#3b82f6', borderRadius: 4},
      {label: 'Coal Out', data: DATA.monthly.coal_out, backgroundColor: '#10b981', borderRadius: 4},
    ]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: {legend: {position: 'top'}},
    scales: {
      y: {beginAtZero: true, grid: {color: gridColor}, ticks: {callback: v => fmt(v)}},
      x: {grid: {color: gridColor}}
    }
  }
});

// Utilization chart (horizontal bar)
new Chart(document.getElementById('utilizationChart'), {
  type: 'bar',
  data: {
    labels: ['Crusher 1', 'Crusher 2', 'Crusher 3', 'Crusher 4'],
    datasets: [
      {label: 'Actual Avg T/Hr', data: [DATA.crushers.CR1.avg, DATA.crushers.CR2.avg, DATA.crushers.CR3.avg, DATA.crushers.CR4.avg], backgroundColor: '#fbbf24', borderRadius: 4},
      {label: 'Target T/Hr', data: [DATA.crushers.CR1.target, DATA.crushers.CR2.target, DATA.crushers.CR3.target, DATA.crushers.CR4.target], backgroundColor: 'rgba(148,163,184,0.5)', borderRadius: 4},
    ]
  },
  options: {
    indexAxis: 'y', responsive: true, maintainAspectRatio: false,
    plugins: {legend: {position: 'top'}},
    scales: {x: {beginAtZero: true, grid: {color: gridColor}}, y: {grid: {color: gridColor}}}
  }
});

// Daily performance line chart
const dailyChart = new Chart(document.getElementById('dailyPerfChart'), {
  type: 'line',
  data: {
    labels: DATA.daily.dates,
    datasets: [
      {label: 'CR1', data: DATA.daily.cr1, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.1)', tension: 0.3, pointRadius: 0, borderWidth: 2},
      {label: 'CR2', data: DATA.daily.cr2, borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.1)', tension: 0.3, pointRadius: 0, borderWidth: 2},
      {label: 'CR3', data: DATA.daily.cr3, borderColor: '#fbbf24', backgroundColor: 'rgba(251,191,36,0.1)', tension: 0.3, pointRadius: 0, borderWidth: 2},
      {label: 'CR4', data: DATA.daily.cr4, borderColor: '#ef4444', backgroundColor: 'rgba(239,68,68,0.1)', tension: 0.3, pointRadius: 0, borderWidth: 2},
    ]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    interaction: {mode: 'index', intersect: false},
    plugins: {legend: {position: 'top'}},
    scales: {
      x: {grid: {color: gridColor}, ticks: {maxTicksLimit: 12}},
      y: {beginAtZero: true, grid: {color: gridColor}, title: {display: true, text: 'T/Hr'}}
    }
  }
});

// Stock chart
new Chart(document.getElementById('stockChart'), {
  type: 'line',
  data: {
    labels: DATA.daily.dates,
    datasets: [{
      label: 'Stock Balance',
      data: DATA.daily.balance,
      borderColor: '#fbbf24',
      backgroundColor: 'rgba(251,191,36,0.15)',
      fill: true, tension: 0.3, pointRadius: 0, borderWidth: 2
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: {legend: {display: false}},
    scales: {
      x: {grid: {color: gridColor}, ticks: {maxTicksLimit: 8}},
      y: {beginAtZero: false, grid: {color: gridColor}, ticks: {callback: v => fmt(v)}}
    }
  }
});

// Sulfur chart
new Chart(document.getElementById('sulfurChart'), {
  type: 'line',
  data: {
    labels: DATA.daily.dates,
    datasets: [
      {label: 'Blending %S', data: DATA.daily.s_blend.map(v => v > 0 ? v : null), borderColor: '#3b82f6', tension: 0.3, pointRadius: 0, borderWidth: 2, spanGaps: true},
      {label: 'Lab %S', data: DATA.daily.s_lab.map(v => v > 0 ? v : null), borderColor: '#10b981', tension: 0.3, pointRadius: 0, borderWidth: 2, spanGaps: true},
      {label: 'Target (0.7)', data: DATA.daily.dates.map(() => 0.7), borderColor: '#ef4444', borderDash: [6,4], pointRadius: 0, borderWidth: 1.5},
    ]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: {legend: {position: 'top'}},
    scales: {
      x: {grid: {color: gridColor}, ticks: {maxTicksLimit: 8}},
      y: {grid: {color: gridColor}, suggestedMin: 0.5, suggestedMax: 0.85, title: {display: true, text: '% Sulfur'}}
    }
  }
});

// Time filter
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const range = btn.dataset.range;
    let start = 0;
    if (range === '30') start = Math.max(0, DATA.daily.dates.length - 30);
    else if (range === '7') start = Math.max(0, DATA.daily.dates.length - 7);
    dailyChart.data.labels = DATA.daily.dates.slice(start);
    dailyChart.data.datasets[0].data = DATA.daily.cr1.slice(start);
    dailyChart.data.datasets[1].data = DATA.daily.cr2.slice(start);
    dailyChart.data.datasets[2].data = DATA.daily.cr3.slice(start);
    dailyChart.data.datasets[3].data = DATA.daily.cr4.slice(start);
    dailyChart.update();
  });
});
</script>
</body>
</html>
