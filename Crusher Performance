<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Crusher Performance Dashboard | Hongsa Power</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Segoe UI', Arial, sans-serif;
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  color: #e2e8f0;
  min-height: 100vh;
  padding: 20px;
}
.container { max-width: 1500px; margin: 0 auto; }

/* Header */
.header {
  background: linear-gradient(90deg, rgba(15,23,42,0.95) 0%, rgba(30,41,59,0.95) 100%);
  border: 1px solid #334155;
  border-radius: 12px;
  padding: 24px 32px;
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}
.header-left h1 {
  font-size: 26px;
  font-weight: 700;
  color: #f1f5f9;
  letter-spacing: 0.5px;
}
.header-left .subtitle {
  color: #94a3b8;
  font-size: 14px;
  margin-top: 4px;
}
.header-right { text-align: right; }
.badge {
  display: inline-block;
  padding: 6px 14px;
  background: #fbbf24;
  color: #0f172a;
  border-radius: 6px;
  font-weight: 700;
  font-size: 12px;
  letter-spacing: 1px;
}
.period {
  color: #cbd5e1;
  font-size: 13px;
  margin-top: 6px;
}

/* Filters */
.filters {
  background: rgba(30,41,59,0.6);
  border: 1px solid #334155;
  border-radius: 10px;
  padding: 16px 24px;
  margin-bottom: 24px;
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  align-items: center;
}
.filters label { font-size: 13px; color: #94a3b8; margin-right: 6px; }
.filter-btn {
  background: rgba(51,65,85,0.6);
  color: #e2e8f0;
  border: 1px solid #475569;
  padding: 6px 14px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 13px;
  transition: all 0.2s;
}
.filter-btn:hover { background: #475569; }
.filter-btn.active {
  background: #fbbf24;
  color: #0f172a;
  border-color: #fbbf24;
  font-weight: 600;
}

/* KPI Cards */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
  margin-bottom: 24px;
}
.kpi-card {
  background: linear-gradient(135deg, rgba(30,41,59,0.9) 0%, rgba(51,65,85,0.7) 100%);
  border: 1px solid #334155;
  border-left: 4px solid #fbbf24;
  border-radius: 10px;
  padding: 20px;
  transition: transform 0.2s, box-shadow 0.2s;
}
.kpi-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.3);
}
.kpi-card.green { border-left-color: #10b981; }
.kpi-card.blue  { border-left-color: #3b82f6; }
.kpi-card.amber { border-left-color: #fbbf24; }
.kpi-card.red   { border-left-color: #ef4444; }
.kpi-label {
  font-size: 12px;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 8px;
}
.kpi-value {
  font-size: 28px;
  font-weight: 700;
  color: #f1f5f9;
  line-height: 1.2;
}
.kpi-unit { font-size: 14px; color: #94a3b8; font-weight: 400; margin-left: 4px; }
.kpi-sub { font-size: 12px; color: #cbd5e1; margin-top: 6px; }

/* Crusher Cards */
.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #f1f5f9;
  margin: 12px 0 16px 0;
  padding-bottom: 8px;
  border-bottom: 1px solid #334155;
  display: flex;
  align-items: center;
  gap: 8px;
}
.section-title::before {
  content: '';
  width: 4px;
  height: 18px;
  background: #fbbf24;
  border-radius: 2px;
}
.crusher-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 18px;
  margin-bottom: 24px;
}
.crusher-card {
  background: rgba(30,41,59,0.85);
  border: 1px solid #334155;
  border-radius: 10px;
  padding: 20px;
}
.crusher-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}
.crusher-name {
  font-size: 16px;
  font-weight: 600;
  color: #f1f5f9;
}
.status-pill {
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
}
.status-good { background: rgba(16,185,129,0.2); color: #10b981; }
.status-warn { background: rgba(251,191,36,0.2); color: #fbbf24; }
.status-poor { background: rgba(239,68,68,0.2); color: #ef4444; }
.crusher-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 14px;
}
.stat-mini { }
.stat-mini-label { font-size: 11px; color: #94a3b8; text-transform: uppercase; }
.stat-mini-value { font-size: 18px; font-weight: 600; color: #f1f5f9; margin-top: 2px; }
.progress-bar-wrap {
  background: rgba(15,23,42,0.6);
  border-radius: 6px;
  height: 12px;
  overflow: hidden;
  margin-top: 4px;
}
.progress-bar {
  height: 100%;
  border-radius: 6px;
  transition: width 0.6s ease;
}
.progress-label {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #cbd5e1;
  margin-top: 6px;
}

/* Chart Cards */
.charts-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 24px;
}
.chart-card {
  background: rgba(30,41,59,0.85);
  border: 1px solid #334155;
  border-radius: 10px;
  padding: 20px;
}
.chart-card.full { grid-column: 1 / -1; }
.chart-title {
  font-size: 15px;
  font-weight: 600;
  color: #f1f5f9;
  margin-bottom: 16px;
}
.chart-wrapper { position: relative; height: 320px; }
.chart-wrapper.tall { height: 360px; }

/* Table */
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th {
  background: rgba(15,23,42,0.8);
  color: #fbbf24;
  padding: 12px 14px;
  text-align: left;
  font-weight: 600;
  letter-spacing: 0.5px;
  border-bottom: 2px solid #fbbf24;
  font-size: 12px;
  text-transform: uppercase;
}
td {
  padding: 12px 14px;
  border-bottom: 1px solid #334155;
  color: #e2e8f0;
}
tr:hover td { background: rgba(51,65,85,0.4); }

/* Footer */
.footer {
  text-align: center;
  color: #64748b;
  font-size: 12px;
  margin-top: 32px;
  padding: 16px;
}

@media (max-width: 900px) {
  .charts-grid { grid-template-columns: 1fr; }
  .header { flex-direction: column; align-items: flex-start; }
  .header-right { text-align: left; }
}
</style>
</head>
<body>
<div class="container">

  <div class="header">
    <div class="header-left">
      <h1>Crusher Performance Dashboard</h1>
      <div class="subtitle">Coal Handling System &middot; Executive Overview</div>
    </div>
    <div class="header-right">
      <div class="badge">HONGSA POWER</div>
      <div class="period" id="period"></div>
    </div>
  </div>

  <div class="filters">
    <label>Time Range:</label>
    <button class="filter-btn active" data-range="ytd">YTD 2026</button>
    <button class="filter-btn" data-range="30">Last 30 Days</button>
    <button class="filter-btn" data-range="7">Last 7 Days</button>
  </div>

  <div class="kpi-grid" id="kpi-grid"></div>

  <div class="section-title">Crusher Status &amp; Utilization</div>
  <div class="crusher-grid" id="crusher-grid"></div>

  <div class="section-title">Performance Trends</div>
  <div class="charts-grid">
    <div class="chart-card">
      <div class="chart-title">Monthly Coal Throughput (tons)</div>
      <div class="chart-wrapper"><canvas id="throughputChart"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">Crusher Avg Performance vs Target (T/Hr)</div>
      <div class="chart-wrapper"><canvas id="utilizationChart"></canvas></div>
    </div>
    <div class="chart-card full">
      <div class="chart-title">Daily Crusher Performance Trend (T/Hr)</div>
      <div class="chart-wrapper tall"><canvas id="dailyPerfChart"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">Coal Stock Balance Over Time (tons)</div>
      <div class="chart-wrapper"><canvas id="stockChart"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">Sulfur Blending Quality (% S)</div>
      <div class="chart-wrapper"><canvas id="sulfurChart"></canvas></div>
    </div>
  </div>

  <div class="section-title">Crusher Detail Summary</div>
  <div class="chart-card">
    <div class="table-wrap">
      <table id="crusherTable">
        <thead>
          <tr>
            <th>Crusher</th>
            <th>Avg T/Hr</th>
            <th>Peak T/Hr</th>
            <th>Target T/Hr</th>
            <th>Utilization</th>
            <th>Operating Days</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

  <div class="footer">
    Hongsa Power Co., Ltd &middot; Coal Operation &middot; Generated for Executive Review
  </div>

</div>

